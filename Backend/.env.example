# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=5000

# MongoDB connection string (Atlas or local)
MONGO_URI=mongodb://127.0.0.1:27017/labyrinth

# Long random string (>= 32 chars). Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=1h

# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000

# Public self-signup (true/false). Turn off once admins create accounts.
ENABLE_SIGNUP=true

# Code execution. "local" runs code on this machine (development only!),
# "docker" runs each run in a locked-down container, "disabled" turns execution off.
JUDGE_MODE=local
# Required to use JUDGE_MODE=local when NODE_ENV=production (strongly discouraged)
ALLOW_UNSAFE_LOCAL_JUDGE=false
JUDGE_IMAGE=labyrinth-judge:latest
JUDGE_CONCURRENCY=2
JUDGE_MAX_QUEUE=50
